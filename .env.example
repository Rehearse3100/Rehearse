# ── App — required locally AND in Vercel ──

# OpenAI — persona chat, stage scoring, and student AI helpers
OPENAI_API_KEY=

# Anam — server-minted session tokens for Discovery / Objection Handling
ANAM_API_KEY=

# Supabase project URL (browser + server clients)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key (browser + server clients)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role — server API routes only; never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Student JWT signing secret (class-based auth — not Supabase Auth)
STUDENT_SESSION_SECRET=

# Legacy phone stages are dormant. See docs/legacy-simulation-path-status.md
# for the keys they require before reviving them.

# ── Local scripts only — NEVER set these in Vercel ──

# HeyGen — onboarding / presenter video generation scripts
HEYGEN_API_KEY=

# Optional local path to the onboarding presenter source video (composite script)
ONBOARDING_PRESENTER_VIDEO=
